<Window x:Class="ShoeManager.Windows.DialogSaldo"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ShoeManager.Windows"
        mc:Ignorable="d"
        Title="Nuevo Saldo / Editar Saldo" 
        Height="500" Width="500" 
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Text="Nuevo Saldo" FontSize="18" FontWeight="Bold" Grid.Row="0" Margin="0,0,0,16" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <GroupBox Header="Información del Producto" Padding="8">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="UPC (código barras):" Grid.Column="0" VerticalAlignment="Center" />
                            <TextBox x:Name="UPCTextBox" Grid.Column="1" ToolTip="Código de barras de fábrica de 12 dígitos" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Marca:" Grid.Column="0" VerticalAlignment="Center" />
                            <TextBox x:Name="MarcaTextBox" Grid.Column="1" ToolTip="Se convertirá a MAYÚSCULAS automáticamente" TextChanged="MarcaTextBox_TextChanged" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Modelo:" Grid.Column="0" VerticalAlignment="Center" />
                            <TextBox x:Name="ModeloTextBox" Grid.Column="1" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Precio (S/):" Grid.Column="0" VerticalAlignment="Center" />
                            <TextBox x:Name="PrecioTextBox" Grid.Column="1" />
                        </Grid>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Stock por Tallas" Padding="8">
                    <StackPanel>
                        <TextBlock Text="Ingresa las tallas y cantidades (ej: 40=10, 42=5, 43=3)" FontSize="11" Foreground="Gray" />
                        <TextBox x:Name="StockTextBox" Height="80" TextWrapping="Wrap" 
                                 AcceptsReturn="True"
                                 ToolTip="Formato: TALLA=CANTIDAD, una por línea&#x0a;Ej:&#x0a;40=10&#x0a;41=8&#x0a;42=12" />
                        <Border Background="#f8f8fc" Padding="6" CornerRadius="4">
                            <TextBlock Text="Ejemplo:&#x0a;40=10&#x0a;41=8&#x0a;42=12" FontSize="11" FontFamily="Consolas" Foreground="#666" />
                        </Border>
                    </StackPanel>
                </GroupBox>

                <GroupBox Header="Fotografías (rutas locales)" Padding="8">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Foto Frontal:" Grid.Column="0" VerticalAlignment="Center" />
                            <TextBox x:Name="FotoFrontalTextBox" Grid.Column="1" />
                            <Button Content="📁" Grid.Column="2" Width="28" Click="BuscarFotoFrontal_Click" Margin="4,0,0,0" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="Foto Perfil:" Grid.Column="0" VerticalAlignment="Center" />
                            <TextBox x:Name="FotoPerfilTextBox" Grid.Column="1" />
                            <Button Content="📁" Grid.Column="2" Width="28" Click="BuscarFotoPerfil_Click" Margin="4,0,0,0" />
                        </Grid>
                    </StackPanel>
                </GroupBox>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Orientation="Horizontal" Grid.Row="2" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Cancelar" Width="100" Height="32" Margin="0,0,8,0" Click="CancelarButton_Click" />
            <Button Content="💾 Guardar" Width="120" Height="32" FontWeight="Bold" Click="GuardarButton_Click" 
                    IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>